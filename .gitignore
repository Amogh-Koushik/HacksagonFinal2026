# ═══════════════════════════════════════════════
#  RiskScope AI - .gitignore
# ═══════════════════════════════════════════════

# ─── Python Bytecode & Cache ────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ─── Python Packaging ──────────────────────
*.egg-info/
*.egg
.eggs/
*.whl
dist/
build/

# ─── Python Virtual Environments ───────────
venv/
env/
.venv/
.env/
ENV/
__pypackages__/

# ─── Python Testing & Linting ──────────────
.pytest_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.tox/
.nox/
.mypy_cache/
.pytype/
.ruff_cache/

# ─── Jupyter Notebooks ────────────────────
.ipynb_checkpoints/

# ─── Node / Frontend ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/
.pnp.*
.eslintcache
package-lock.json

# ─── Vite / Build Output ─────────────────
frontend/dist/
frontend/dist-ssr/
*.local

# ─── IDE / Editor ────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sw?
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.sublime-project

# ─── ML Model Binaries (LARGE files) ─────
# These are 18-21 MB each — NEVER push to repo
ML/models/*.pkl
ML/models/*.joblib
ML/models/*.onnx
ML/models/*.h5
ML/models/*.hdf5
ML/models/*.pt
ML/models/*.pth
ML/models/*.pb
backend/artifacts/*.pkl
backend/artifacts/*.joblib
backend/artifacts/*.onnx
backend/artifacts/*.h5

# ─── ML Training Data (LARGE CSVs) ───────
# Training data is generated, not source code
ML/data/*.csv
ML/data/*.npy
ML/data/*.npz
ML/data/*.parquet
ML/data/*.feather

# ─── ML Output / Results Files ───────────
ML/explain_results.txt
ML/safety_results.txt
ML/models/training_report.txt

# ─── Synthea (large generated FHIR data) ──
synthea/
!synthea/.gitkeep

# ─── Environment / Secrets ───────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# ─── OS Files ────────────────────────────
.DS_Store
Desktop.ini
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# ─── Logs & Temp Files ──────────────────
*.log
*.tmp
*.bak
*.cache
*.pid

# ─── AI Assistant / Tooling ─────────────
.gemini/
.cursor/
.copilot/
.agents/
.agent/
_agents/
_agent/

# ─── Misc ───────────────────────────────
*.tgz
*.tar.gz
*.zip
*.map

# ─── PowerPoint Templates ───────────────
# Optional: uncomment if you don't want PPT in repo
# *.pptx

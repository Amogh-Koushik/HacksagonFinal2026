.mypy_cache/
.ruff_cache/

# Jupyter / notebooks
.ipynb_checkpoints/

# Logs
*.log

# OS/editor files
.DS_Store
.vscode/
.idea/

# Model artifacts (keep folder, ignore heavy binaries)
artifacts/*.pkl
artifacts/*.joblib
artifacts/*.onnx
artifacts/*.h5

# Optional local databases
*.sqlite3
